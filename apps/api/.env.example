# Copy this to .env and fill in the values
# See root .env.example for all variables

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedisense_dev
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
CORS_ORIGIN=http://localhost:3000
STORAGE_PATH=./uploads
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@wedisense.com
UPCITEMDB_API_KEY=
GO_UPC_API_KEY=

# Phase 17 v2 — Odoo PO PDF AI parser (spec §2.3).
# Gateway: OpenRouter (single API key, auto-fallback across providers).
# Fallback chain: claude-haiku-4.5 → gpt-4o-mini → gemini-2.5-flash.
# Get a key at https://openrouter.ai → top-up min $5. Leave blank to
# disable AI mode — users will see a 503 when they pick AI in the
# parser toggle, and can switch to Regex.
OPENROUTER_API_KEY=

# Public-facing base URL of the Wedison app. Used as the HTTP-Referer
# header on OpenRouter calls so usage is attributed to your app in
# their dashboard. Optional; falls back to a placeholder when empty.
APP_BASE_URL=
