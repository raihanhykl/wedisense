# Copy this to .env and fill in the values
# See root .env.example for all variables

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedisense_dev
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
CORS_ORIGIN=http://localhost:3000
STORAGE_PATH=./uploads
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@wedisense.com
UPCITEMDB_API_KEY=
GO_UPC_API_KEY=

# Phase 17 v2 — Odoo PO PDF AI parser (spec §2.3).
# Gateway: OpenRouter (single API key, auto-fallback across providers).
# Current fallback chain (free tier — no top-up required):
#   gemma-4-31b-it:free → gemma-4-26b-a4b-it:free → baidu/cobuddy:free
# Get a key at https://openrouter.ai (sign-up is enough; :free models
# do not require credits — adding $5 only lifts the 200 req/day global
# cap). Leave blank to disable AI mode — users will see a 503 when
# they pick AI in the parser toggle, and can switch to Regex.
OPENROUTER_API_KEY=

# Public-facing base URL of the Wedison app. Used as the HTTP-Referer
# header on OpenRouter calls so usage is attributed to your app in
# their dashboard. Optional; falls back to a placeholder when empty.
APP_BASE_URL=

# ── Seed credentials (optional) ─────────────────────────────────────
# Override the demo-user passwords created by `pnpm prisma:seed`.
# If unset, a random password is generated per user on each run and
# printed to stdout once. Set these for a stable local dev login.
#   Min length: 8 chars.
SEED_DEMO_PASSWORD=               # shared password for all demo users
SEED_DEMO_PASSWORD_EMP001=        # per-user override (super admin)
SEED_DEMO_PASSWORD_EMP002=        # per-user override (admin)
SEED_DEMO_PASSWORD_EMP003=        # per-user override (manager)

# ── Bootstrap admin (production first-deploy only) ──────────────────
# Creates the first SUPER_ADMIN user when the users table is empty.
# After the admin is created and a real password is set via UI, these
# env vars stop being used (bootstrap skips while any user exists).
#   Min password length: 12 chars. Generate with `openssl rand -base64 24`.
BOOTSTRAP_ADMIN_EMAIL=admin@wedison.co
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMPLOYEE_ID=BOOTSTRAP
