  createdBy User       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  printJobs PrintJob[]

  @@index([createdByUserId])
  @@map("label_templates")
}

model PrintJob {
  id              String         @id @default(uuid()) @db.Uuid
  labelTemplateId String         @map("label_template_id") @db.Uuid
  assetIds        Json           @map("asset_ids")
  copiesPerAsset  Int            @default(1) @map("copies_per_asset")
  status          PrintJobStatus @default(PENDING) @map("status")
  pdfUrl          String?        @map("pdf_url")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
