generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum AssetStatus {
  ACTIVE
  IDLE
  IN_MAINTENANCE
  DISPOSED
  LOST
  BORROWED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum MovementType {
  ASSIGNMENT
  UNASSIGNMENT
  LOCATION_TRANSFER
  LOAN_OUT
  LOAN_RETURN
  RESIGNATION_RETURN
  SWAP
  SEND_TO_MAINTENANCE
  RETURN_FROM_MAINTENANCE
  DISPOSAL
  FOUND
  LOST
  INITIAL
}

enum MovementStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

// Direction of a physical handover (Berita Acara Serah Terima). Distinct
// from MovementType: one handover form can produce several movements of
// possibly different types (a resignation return unassigns N assets), so
// the form describes *who signed what*, not *how each asset moved*.
enum HandoverType {
  COMPANY_TO_EMPLOYEE // penyerahan: perusahaan → karyawan
  EMPLOYEE_TO_EMPLOYEE // pemindahtanganan: karyawan A → karyawan B
  EMPLOYEE_TO_COMPANY // pengembalian: karyawan → perusahaan (resign, mutasi)
}

// DRAFT → ISSUED happens the first time the PDF is generated: once a
// document number is on paper heading for signatures, its content must
// stop changing. ISSUED → SIGNED on scan upload. CANCELLED is terminal
// and replaces deletion for forms that already reached ISSUED.
enum HandoverFormStatus {
  DRAFT
  ISSUED
  SIGNED
  CANCELLED
}

enum LocationType {
  HEAD_OFFICE
  BRANCH
  FACTORY
  SHOWROOM
  SERVICE_CENTER
  OTHER
}

enum BarcodeType {
  CODE128
  QR
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  NONE
}

enum FrequencyType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  PRINT
  APPROVE
  REJECT
}

enum NotificationType {
  WARRANTY_EXPIRING
  LOAN_OVERDUE
  MAINTENANCE_DUE
  ASSET_LOST
  REPORT_READY
  PRINT_READY
  IMPORT_COMPLETE
  ASSET_DISPOSED
  TOUR_UPDATED
}

enum ReportType {
  ASSET_LIST
  MOVEMENT
  MAINTENANCE
  DEPRECIATION
  AUDIT
  CUSTOM
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  READY
  PRINTED
  FAILED
}

enum ProductSource {
  API_UPCITEMDB
  API_BARCODELOOKUP
  MANUAL
}

enum ReportSchedule {
  DAILY
  WEEKLY
  MONTHLY
}

// Procurement lifecycle.
//
// A PurchaseOrder is the commercial commitment to a vendor. Status walks
// forward as goods arrive: OPEN → PARTIALLY_RECEIVED (≥1 child batch
// received) → FULLY_RECEIVED (all batches received) → CLOSED (admin
// finalises). CANCELLED is terminal and reachable only from OPEN or
// PARTIALLY_RECEIVED — once any item is RECEIVED the batch stays on the
// books even if the rest of the PO is voided.
enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

// One ProcurementBatch == one BAST event == one physical hand-over.
// DRAFT  : header created, no assets yet
// ITEMS_PENDING : assets created and linked, awaiting physical receipt
// RECEIVED      : BAST signed + items physically received
// COMPLETED     : invoice + tax invoice in, batch locked (immutable)
// CANCELLED     : only reachable from DRAFT / ITEMS_PENDING (never after
//                 RECEIVED — assets are already live by then)
enum ProcurementBatchStatus {
  DRAFT
  ITEMS_PENDING
  RECEIVED
  COMPLETED
  CANCELLED
}

// ─── Models ─────────────────────────────────────────────────────────────────────

// A User row is first and foremost an EMPLOYEE record (asset holder,
// handover party, future HR module). A login account on top of it is
// optional: `passwordHash` is NULL for employees who never sign in, and
// `email` is NULL when the employee has none. Postgres allows multiple
// NULLs under a UNIQUE constraint, so uniqueness still holds for every
// employee who does have an email. Login requires BOTH to be present.
model User {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @map("name")
  email             String?    @unique @map("email")
  passwordHash      String?    @map("password_hash")
  employeeId        String     @map("employee_id")
  phone             String?    @map("phone")
  avatarUrl         String?    @map("avatar_url")
  preferredLanguage String     @default("id") @map("preferred_language")
  status            UserStatus @default(ACTIVE) @map("status")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  // Relations
  userRoles                   UserRole[]
  assignedAssets              Asset[]               @relation("AssetAssignedTo")
  performedMovements          AssetMovement[]       @relation("MovementPerformedBy")
  approvedMovements           AssetMovement[]       @relation("MovementApprovedBy")
  movementsAsFromUser         AssetMovement[]       @relation("MovementFromUser")
  movementsAsToUser           AssetMovement[]       @relation("MovementToUser")
  maintenanceSchedules        MaintenanceSchedule[] @relation("MaintenanceAssignedTo")
  maintenanceLogs             MaintenanceLog[]      @relation("MaintenancePerformedBy")
  notifications               Notification[]
  auditLogs                   AuditLog[]
  createdAssets               Asset[]               @relation("AssetCreatedBy")
  reports                     Report[]
  printJobs                   PrintJob[]
  labelTemplates              LabelTemplate[]
  tourProgress                UserTourProgress[]
  savedViews                  UserSavedView[]
  locationsAsContact          Location[]            @relation("LocationContact")
  createdPurchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  closedPurchaseOrders        PurchaseOrder[]       @relation("PurchaseOrderClosedBy")
  createdProcurementBatches   ProcurementBatch[]    @relation("ProcurementBatchCreatedBy")
  receivedProcurementBatches  ProcurementBatch[]    @relation("ProcurementBatchReceivedBy")
  completedProcurementBatches ProcurementBatch[]    @relation("ProcurementBatchCompletedBy")
  handoverFormsAsItOfficer    HandoverForm[]        @relation("HandoverItOfficer")
  handoverFormsAsFromUser     HandoverForm[]        @relation("HandoverFromUser")
  handoverFormsAsToUser       HandoverForm[]        @relation("HandoverToUser")
  handoverFormsAcknowledged   HandoverForm[]        @relation("HandoverAcknowledgedBy")
  createdHandoverForms        HandoverForm[]        @relation("HandoverCreatedBy")
  uploadedHandoverScans       HandoverForm[]        @relation("HandoverScanUploadedBy")

  // SMS (Stock Management System)
  smsShipmentsCreated        SmsShipment[]      @relation("SmsShipmentCreatedBy")
  smsShipmentLinesReceived   SmsShipmentLine[]  @relation("SmsShipmentLineReceivedBy")
  smsUnitsCreated            SmsUnit[]          @relation("SmsUnitCreatedBy")
  smsUnitEventsPerformed     SmsUnitEvent[]     @relation("SmsUnitEventPerformedBy")
  smsOrdersAsSales           SmsOrder[]         @relation("SmsOrderSales")
  smsOrdersCreated           SmsOrder[]         @relation("SmsOrderCreatedBy")
  smsRtoContractsAsSales     SmsRtoContract[]   @relation("SmsRtoContractSales")
  smsRtoContractsClosed      SmsRtoContract[]   @relation("SmsRtoContractClosedBy")
  smsRtoContractsCreated     SmsRtoContract[]   @relation("SmsRtoContractCreatedBy")
  smsReturnRequestsRequested SmsReturnRequest[] @relation("SmsReturnRequestRequestedBy")
  smsReturnRequestsDecided   SmsReturnRequest[] @relation("SmsReturnRequestDecidedBy")
  smsInspectionsAsInspector  SmsInspection[]    @relation("SmsInspectionInspector")
  smsInspectionsCreated      SmsInspection[]    @relation("SmsInspectionCreatedBy")
  smsShowLoansAsPic          SmsShowLoan[]      @relation("SmsShowLoanPic")
  smsShowLoansCreated        SmsShowLoan[]      @relation("SmsShowLoanCreatedBy")

  @@index([status])
  @@index([deletedAt])
  @@index([employeeId])
  @@map("users")
}

// Per-user saved filter/sort/column configurations for list pages. One row =
// one named view ("Laptop di Pondok Indah"); `config` is a JSON blob shaped
// and validated by the app (no DB-level constraint on its keys). `resource`
// is the list it applies to ("assets" today, extensible to "movements" etc.
// without a schema change). At most one default per (userId, resource) pair
// is enforced in service code, not via partial unique index — Postgres
// supports it but it makes "set as default" require an extra round-trip to
// clear the previous default, and the enforcement is simple in app code.
model UserSavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  resource  String   @map("resource")
  name      String   @map("name")
  config    Json     @map("config")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource])
  @@map("user_saved_views")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @map("name")
  description String?  @map("description")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  onboardingTours OnboardingTour[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String @map("resource")
  action   String @map("action")

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  roleId     String  @map("role_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, locationId])
  @@index([userId])
  @@index([roleId])
  @@index([locationId])
  @@map("user_roles")
}

model Location {
  id       String       @id @default(uuid()) @db.Uuid
  name     String       @map("name")
  code     String       @unique @map("code")
  address  String?      @map("address")
  city     String?      @map("city")
  province String?      @map("province")
  type     LocationType @map("type")
  parentId String?      @map("parent_id") @db.Uuid
  isActive Boolean      @default(true) @map("is_active")

  // Geographic coordinates (decimal degrees, WGS84). Decimal(10,7) ≈ 1cm
  // precision — adequate for site-level pins on Leaflet/OpenStreetMap.
  latitude  Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude Decimal? @map("longitude") @db.Decimal(11, 7)

  // Single primary photo. Multi-photo gallery would land as a separate
  // LocationAttachment table; not modelled here until that need is real.
  photoUrl String? @map("photo_url")

  // Auto-generated QR encoding {APP_BASE_URL}/locations/{id} for mobile
  // scan-to-detail. Image is materialised by the StorageAdapter the first
  // time the /qrcode endpoint is hit.
  qrCodeImageUrl String? @map("qr_code_image_url")

  // On-site contact. contactUserId points to an internal User if applicable;
  // contactPhone/contactEmail stand alone for external contacts (vendors,
  // building managers) where no User row exists.
  contactUserId String? @map("contact_user_id") @db.Uuid
  contactPhone  String? @map("contact_phone")
  contactEmail  String? @map("contact_email")

  // Hours-of-operation. Loose shape, e.g.
  // { mon: { open: "08:00", close: "17:00" }, tue: "closed", … }
  operatingHours Json? @map("operating_hours")

  // Per-location custom data. The shape contract is held by app-level
  // config (keyed by location type), not by the schema — keeps the JSONB
  // truly extensible across future location types.
  customFields Json? @map("custom_fields")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  parent                      Location?          @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                    Location[]         @relation("LocationTree")
  contactUser                 User?              @relation("LocationContact", fields: [contactUserId], references: [id], onDelete: SetNull)
  assets                      Asset[]
  userRoles                   UserRole[]
  movementsFrom               AssetMovement[]    @relation("MovementFromLocation")
  movementsTo                 AssetMovement[]    @relation("MovementToLocation")
  procurementBatchesAsDefault ProcurementBatch[] @relation("ProcurementBatchDefaultLocation")
  handoverFormsFrom           HandoverForm[]     @relation("HandoverFromLocation")
  handoverFormsTo             HandoverForm[]     @relation("HandoverToLocation")

  // SMS (Stock Management System)
  smsShipmentsAsDestination SmsShipment[]      @relation("SmsShipmentDestination")
  smsShipmentsAsOrigin      SmsShipment[]      @relation("SmsShipmentOrigin")
  smsUnitsPhysicallyHere    SmsUnit[]          @relation("SmsUnitPhysicalLocation")
  smsUnitsResponsibleFor    SmsUnit[]          @relation("SmsUnitResponsibleShowroom")
  smsUnitEvents             SmsUnitEvent[]     @relation("SmsUnitEventLocation")
  smsOrders                 SmsOrder[]         @relation("SmsOrderShowroom")
  smsRtoContractsOriginated SmsRtoContract[]   @relation("SmsRtoContractOriginShowroom")
  smsRtoContractsReceived   SmsRtoContract[]   @relation("SmsRtoContractReceivedAtShowroom")
  smsReturnRequestsFrom     SmsReturnRequest[] @relation("SmsReturnRequestFromShowroom")
  smsReturnRequestsTo       SmsReturnRequest[] @relation("SmsReturnRequestToShowroom")
  smsShowLoans              SmsShowLoan[]      @relation("SmsShowLoanShowroom")

  @@index([parentId])
  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@index([contactUserId])
  @@map("locations")
}

model AssetCategory {
  id                      String             @id @default(uuid()) @db.Uuid
  name                    String             @map("name")
  code                    String             @unique @map("code")
  description             String?            @map("description")
  parentId                String?            @map("parent_id") @db.Uuid
  depreciationMethod      DepreciationMethod @default(NONE) @map("depreciation_method")
  defaultDepreciationRate Float?             @map("default_depreciation_rate")
  defaultUsefulLifeMonths Int?               @map("default_useful_life_months")
  icon                    String?            @map("icon")
  color                   String?            @map("color")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  deletedAt               DateTime?          @map("deleted_at")

  // Relations
  parent                      AssetCategory?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                    AssetCategory[]    @relation("CategoryTree")
  products                    Product[]
  procurementBatchesAsDefault ProcurementBatch[] @relation("ProcurementBatchDefaultCategory")

  @@index([parentId])
  @@index([deletedAt])
  @@map("asset_categories")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  eanCode        String?       @unique @map("ean_code")
  name           String        @map("name")
  brand          String?       @map("brand")
  model          String?       @map("model")
  description    String?       @map("description")
  categoryId     String        @map("category_id") @db.Uuid
  imageUrl       String?       @map("image_url")
  source         ProductSource @map("source")
  rawApiResponse Json?         @map("raw_api_response")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  category           AssetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assets             Asset[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([categoryId])
  @@index([eanCode])
  @@index([name])
  @@map("products")
}

model AssetNumberSequence {
  id              String @id @default(uuid()) @db.Uuid
  categoryCode    String @map("category_code")
  year            Int    @map("year")
  currentSequence Int    @default(0) @map("current_sequence")

  @@unique([categoryCode, year])
  @@map("asset_number_sequences")
}

model Asset {
  id                String         @id @default(uuid()) @db.Uuid
  assetNumber       String         @unique @map("asset_number")
  productId         String         @map("product_id") @db.Uuid
  serialNumber      String?        @unique @map("serial_number")
  barcodeValue      String         @unique @map("barcode_value")
  barcodeType       BarcodeType    @default(CODE128) @map("barcode_type")
  barcodeImageUrl   String?        @map("barcode_image_url")
  name              String         @map("name")
  status            AssetStatus    @default(ACTIVE) @map("status")
  condition         AssetCondition @default(NEW) @map("condition")
  locationId        String         @map("location_id") @db.Uuid
  assignedToUserId  String?        @map("assigned_to_user_id") @db.Uuid
  purchaseDate      DateTime?      @map("purchase_date")
  purchasePrice     Decimal?       @map("purchase_price") @db.Decimal(15, 2)
  currency          String         @default("IDR") @map("currency")
  // Phase 17 v2: vendor migration to FK relation.
  //   - `vendorId` + `vendor` relation (NEW, preferred): FK to Vendor
  //     registry. Used by the create form (VendorPicker) and the detail
  //     page's Procurement section. SetNull on vendor deletion so
  //     soft-deleting a Vendor doesn't kill linked assets.
  //   - `vendorLegacy` (DEPRECATED): free-text string kept for
  //     backwards compatibility with assets created before the
  //     migration. Maps to the existing `vendor` DB column to avoid a
  //     data-loss migration. New writes should NOT populate this field;
  //     code reads `vendor.name` (relation) first, falls back to
  //     `vendorLegacy` only when vendorId is null. Will be dropped in a
  //     follow-up migration once all rows have a vendorId.
  vendorLegacy      String?        @map("vendor")
  vendorId          String?        @map("vendor_id") @db.Uuid
  invoiceNumber     String?        @map("invoice_number")
  invoiceUrl        String?        @map("invoice_url")
  warrantyStartDate DateTime?      @map("warranty_start_date")
  warrantyEndDate   DateTime?      @map("warranty_end_date")
  usefulLifeMonths  Int?           @map("useful_life_months")
  currentBookValue  Decimal?       @map("current_book_value") @db.Decimal(15, 2)
  notes             String?        @map("notes")
  customFields      Json?          @map("custom_fields")
  createdByUserId   String         @map("created_by_user_id") @db.Uuid

  // Nullable: keeps existing rows valid (legacy assets carry no batch),
  // and single-asset create flows (manual entry, EAN scan) may skip the
  // batch link. Service-layer enforces non-null only on the bulk-import
  // path so a procurement audit can land on a single batch row.
  procurementBatchId String? @map("procurement_batch_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  location             Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignedTo           User?                 @relation("AssetAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy            User                  @relation("AssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  procurementBatch     ProcurementBatch?     @relation(fields: [procurementBatchId], references: [id], onDelete: SetNull)
  vendor               Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  movements            AssetMovement[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs      MaintenanceLog[]
  handoverItems        HandoverFormItem[]

  @@index([assetNumber])
  @@index([serialNumber])
  @@index([barcodeValue])
  @@index([productId])
  @@index([locationId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([condition])
  @@index([warrantyEndDate])
  @@index([createdByUserId])
  @@index([procurementBatchId])
  @@index([vendorId])
  @@index([deletedAt])
  @@map("assets")
}

model AssetMovement {
  id                 String         @id @default(uuid()) @db.Uuid
  assetId            String         @map("asset_id") @db.Uuid
  movementType       MovementType   @map("movement_type")
  referenceNumber    String         @unique @map("reference_number")
  fromUserId         String?        @map("from_user_id") @db.Uuid
  toUserId           String?        @map("to_user_id") @db.Uuid
  fromLocationId     String?        @map("from_location_id") @db.Uuid
  toLocationId       String?        @map("to_location_id") @db.Uuid
  performedByUserId  String         @map("performed_by_user_id") @db.Uuid
  approvedByUserId   String?        @map("approved_by_user_id") @db.Uuid
  notes              String?        @map("notes")
  attachments        Json?          @map("attachments")
  expectedReturnDate DateTime?      @map("expected_return_date")
  actualReturnDate   DateTime?      @map("actual_return_date")
  status             MovementStatus @default(COMPLETED) @map("status")

  // Link to the signed paper document (Berita Acara Serah Terima) that
  // authorised this movement. Nullable — most movement types (maintenance,
  // disposal, found/lost) carry no handover form, and legacy rows have none.
  //
  // ALWAYS set at INSERT, never by UPDATE: asset_movements is append-only.
  // That constraint is why the scanned PDF lives on HandoverForm rather
  // than in this row's `attachments` — the scan arrives after the movement
  // is written, and updating the movement to attach it would violate the
  // append-only rule. One form → many movements (a resignation return
  // writes one row per asset), so the FK points this way, not the reverse.
  handoverFormId String? @map("handover_form_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fromUser     User?     @relation("MovementFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser       User?     @relation("MovementToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  fromLocation Location? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  performedBy  User      @relation("MovementPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  approvedBy   User?     @relation("MovementApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  // Restrict: a form with movements against it is the legal record for
  // those movements and must not disappear. Service-layer blocks deletion
  // of a linked form before Postgres has to.
  handoverForm HandoverForm? @relation(fields: [handoverFormId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([movementType])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([performedByUserId])
  @@index([approvedByUserId])
  @@index([status])
  @@index([expectedReturnDate])
  @@index([createdAt])
  @@map("asset_movements")
}

model MaintenanceSchedule {
  id               String        @id @default(uuid()) @db.Uuid
  assetId          String        @map("asset_id") @db.Uuid
  title            String        @map("title")
  description      String?       @map("description")
  frequencyType    FrequencyType @map("frequency_type")
  nextDueDate      DateTime      @map("next_due_date")
  lastDoneDate     DateTime?     @map("last_done_date")
  assignedToUserId String?       @map("assigned_to_user_id") @db.Uuid
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  asset      Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("MaintenanceAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  logs       MaintenanceLog[]

  @@index([assetId])
  @@index([assignedToUserId])
  @@index([nextDueDate])
  @@index([isActive])
  @@index([frequencyType])
  @@map("maintenance_schedules")
}

model MaintenanceLog {
  id                    String         @id @default(uuid()) @db.Uuid
  assetId               String         @map("asset_id") @db.Uuid
  maintenanceScheduleId String?        @map("maintenance_schedule_id") @db.Uuid
  performedByUserId     String         @map("performed_by_user_id") @db.Uuid
  performedAt           DateTime       @map("performed_at")
  description           String         @map("description")
  findings              String?        @map("findings")
  actionTaken           String?        @map("action_taken")
  cost                  Decimal?       @map("cost") @db.Decimal(15, 2)
  vendorName            String?        @map("vendor_name")
  invoiceUrl            String?        @map("invoice_url")
  conditionBefore       AssetCondition @map("condition_before")
  conditionAfter        AssetCondition @map("condition_after")
  attachments           Json?          @map("attachments")
  createdAt             DateTime       @default(now()) @map("created_at")

  // Relations
  asset       Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schedule    MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull)
  performedBy User                 @relation("MaintenancePerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([maintenanceScheduleId])
  @@index([performedByUserId])
  @@index([performedAt])
  @@map("maintenance_logs")
}

model LabelTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @map("name")
  description     String?  @map("description")
  paperWidthMm    Float    @map("paper_width_mm")
  paperHeightMm   Float    @map("paper_height_mm")
  isDefault       Boolean  @default(false) @map("is_default")
  fields          Json     @map("fields")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

