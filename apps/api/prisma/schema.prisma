  // Relations
  labelTemplate LabelTemplate @relation(fields: [labelTemplateId], references: [id], onDelete: Restrict)
  createdBy     User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([labelTemplateId])
  @@index([createdByUserId])
  @@index([status])
  @@map("print_jobs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @map("type")
  title     String           @map("title")
  message   String           @map("message")
  data      Json?            @map("data")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  action       AuditAction @map("action")
  resourceType String      @map("resource_type")
  resourceId   String      @map("resource_id")
  oldValues    Json?       @map("old_values")
  newValues    Json?       @map("new_values")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Report {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @map("name")
  type            ReportType      @map("type")
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  parameters      Json?           @map("parameters")
  schedule        ReportSchedule? @map("schedule")
  lastGeneratedAt DateTime?       @map("last_generated_at")
  fileUrl         String?         @map("file_url")
  status          ReportStatus    @default(PENDING) @map("status")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId])
  @@index([type])
  @@index([status])
  @@index([schedule])
  @@map("reports")
}

model OnboardingTour {
  id          String   @id @default(uuid()) @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  name        String   @map("name")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  steps       Json     @map("steps")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  role         Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userProgress UserTourProgress[]

  @@index([roleId])
  @@index([isActive])
  @@map("onboarding_tours")
}

model UserTourProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tourId         String    @map("tour_id") @db.Uuid
  completedSteps Json      @default("[]") @map("completed_steps")
  isCompleted    Boolean   @default(false) @map("is_completed")
  isSkipped      Boolean   @default(false) @map("is_skipped")
  lastSeenAt     DateTime? @map("last_seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour OnboardingTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@index([userId])
  @@index([tourId])
  @@map("user_tour_progress")
}

// Phase 17 v2 — Vendor as first-class DB entity. Previously a free-text
// string on PurchaseOrder; the spec now requires a registry so the user
// picks vendors via autocomplete (no typo-driven splits) and we can
// surface per-vendor procurement history. Vendor.name is unique so the
// autocomplete's "create new" path is naturally idempotent.
model Vendor {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique @map("name")
  // Indonesian NPWP (15 digits, free-text for now — DJP-format validation
  // when we wire eFaktur integration). Optional.
  taxId         String? @map("tax_id")
  email         String? @map("email")
  phone         String? @map("phone")
  address       String? @map("address")
  contactPerson String? @map("contact_person")
  notes         String? @map("notes")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  purchaseOrders PurchaseOrder[]
  // Phase 17 v2: Asset.vendor (formerly free-text) is now an FK to this
  // table — surfaces "which vendor supplied this asset" without scanning
  // the parent PO for assets that came in via procurement.
  assets         Asset[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("vendors")
}

// PurchaseOrder — the commercial commitment layer. The redesign drops
// the single flat `totalAmount` in favour of computed totals derived
// from the PO's line items (PurchaseOrderItem). Vendor is now a FK to
// the Vendor table.
model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid

  // SP-YYYY-NNNN — generated server-side via PurchaseOrderSequence.
  poNumber    String              @unique @map("po_number")
  name        String?             @map("name")
  description String?             @map("description")
  status      PurchaseOrderStatus @default(OPEN) @map("status")

  vendorId String @map("vendor_id") @db.Uuid

  poDate               DateTime  @map("po_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  poUrl                String?   @map("po_url")

  currency String @default("IDR") @map("currency")

  // Computed totals from line items, stored denormalised so the list
  // view doesn't issue an aggregation query per row. Recomputed inside
  // the same transaction that mutates items.
  untaxedAmount Decimal @default(0) @map("untaxed_amount") @db.Decimal(15, 2)
  totalTaxes    Decimal @default(0) @map("total_taxes") @db.Decimal(15, 2)
  totalAmount   Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)

  // Denormalised counters maintained inside the same $transaction that
  // mutates batches/assets.
  batchCount Int @default(0) @map("batch_count")
  assetCount Int @default(0) @map("asset_count")

  notes        String? @map("notes")
  attachments  Json?   @map("attachments")
  customFields Json?   @map("custom_fields")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  closedByUserId  String?   @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime? @map("closed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy  User?               @relation("PurchaseOrderClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]
  batches   ProcurementBatch[]

  @@index([poNumber])
  @@index([status])
  @@index([vendorId])
  @@index([poDate])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("purchase_orders")
}

// Phase 17 v2 — PurchaseOrderItem: one line per product-on-PO.
// Multiple line items allowed per PO (spec 2.6). Tax is computed
// EXCLUSIVE (spec 2.7):
//
//   untaxed_amount = qty × unit_price × (1 - discount_percent/100)
//   tax_amount     = untaxed_amount × tax_percent/100
//   total_amount   = untaxed_amount + tax_amount
//
// All three amount fields are denormalised at write time — they never
// drift from the inputs because the service recomputes on every
// create/update inside the same transaction.
model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid

  qty       Int     @map("qty")
  unitPrice Decimal @map("unit_price") @db.Decimal(15, 2)

  // Discount + tax as PERCENT, not absolute. 0 = none, 11 = 11%.
  // Decimal(5,2) gives us 999.99% headroom which is silly-but-safe;
  // matches Odoo's invoice precision.
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)

  untaxedAmount Decimal @map("untaxed_amount") @db.Decimal(15, 2)
  taxAmount     Decimal @map("tax_amount") @db.Decimal(15, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(15, 2)

  // Display order in the line-items table. Free-numbered (0, 10, 20…)
  // so reordering doesn't require renumbering siblings.
  sortOrder Int @default(0) @map("sort_order")

  notes String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchItems    BatchItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// One row = one physical receipt event = one BAST. Carries the
// document chain (BAST, supplier invoice, faktur pajak) and the
// signatory in a HYBRID shape: receivedByUserId for internal staff,
// receivedByName/receivedByPosition for external (vendor) signers.
//
// Phase 17 v2: purchaseOrderId is now MANDATORY — direct-purchase
// batches were removed per spec. Direct purchase flows route through
// /assets/new instead.
model ProcurementBatch {
  id String @id @default(uuid()) @db.Uuid

  purchaseOrderId String @map("purchase_order_id") @db.Uuid

  // BATCH-YYYYMM-NNNN — generated server-side via ProcurementBatchSequence.
  batchNumber String                 @unique @map("batch_number")
  name        String?                @map("name")
  status      ProcurementBatchStatus @default(DRAFT) @map("status")

  // ── Dokumen 1: BAST (Berita Acara Serah Terima) — the primary
  // hand-over document under Indonesian procurement standards.
  bastNumber String?   @map("bast_number")
  bastDate   DateTime? @map("bast_date")
  bastUrl    String?   @map("bast_url")

  // ── Dokumen 2: supplier invoice.
  invoiceNumber String?   @map("invoice_number")
  invoiceDate   DateTime? @map("invoice_date")
  invoiceUrl    String?   @map("invoice_url")

  // ── Dokumen 3: Faktur Pajak (DJP eFaktur). Free-text for Phase 1 —
  // DJP format validation deferred until we wire the eFaktur integration.
  taxInvoiceNumber String?   @map("tax_invoice_number")
  taxInvoiceDate   DateTime? @map("tax_invoice_date")

  // Dates: purchaseDate inherits from PO at create time, but can be
  // overridden (e.g. when the PO covers items priced as of a different
  // date). receivedDate is usually the BAST date.
  purchaseDate DateTime  @map("purchase_date")
  receivedDate DateTime? @map("received_date")

  currency    String  @default("IDR") @map("currency")
  // Phase 17 v2: totalAmount on Batch is now computed from BatchItems
  // (sum of qtyReceived × line item unit price × tax/discount). Stored
  // denormalised so list/detail render doesn't need an aggregation.
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)

  // Defaults applied to assets at import time. Each asset row may
  // override these — the batch values are only the starting point.
  defaultLocationId String? @map("default_location_id") @db.Uuid
  defaultCategoryId String? @map("default_category_id") @db.Uuid

  // Hybrid signatory model. receivedByUserId carries the internal-staff
  // case; receivedByName/Position carry the external case (vendor PIC,
  // building manager, etc.). Service layer enforces "at least one of"
  // when batch transitions to RECEIVED.
  receivedByUserId   String? @map("received_by_user_id") @db.Uuid
  receivedByName     String? @map("received_by_name")
  receivedByPosition String? @map("received_by_position")

  assetCount Int @default(0) @map("asset_count")

  notes        String? @map("notes")
  attachments  Json?   @map("attachments")
  customFields Json?   @map("custom_fields")

  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime? @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  defaultLocation Location?      @relation("ProcurementBatchDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  defaultCategory AssetCategory? @relation("ProcurementBatchDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  receivedBy      User?          @relation("ProcurementBatchReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("ProcurementBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy     User?          @relation("ProcurementBatchCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  items           BatchItem[]
  assets          Asset[]

  @@index([purchaseOrderId])
  @@index([batchNumber])
  @@index([status])
  @@index([bastNumber])
  @@index([invoiceNumber])
  @@index([purchaseDate])
  @@index([receivedDate])
  @@index([defaultLocationId])
  @@index([defaultCategoryId])
  @@index([receivedByUserId])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("procurement_batches")
}

// Phase 17 v2 — BatchItem: "how many of THIS PO line item did we
// physically receive in THIS batch". One row per (batch × POItem) pair.
// The unique constraint prevents double-counting; service-layer
// validation guards against qtyReceived overflowing the parent PO
// line's qty (across all batches).
model BatchItem {
  id                  String @id @default(uuid()) @db.Uuid
  procurementBatchId  String @map("procurement_batch_id") @db.Uuid
  purchaseOrderItemId String @map("purchase_order_item_id") @db.Uuid

  qtyReceived Int @map("qty_received")

  notes String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  procurementBatch  ProcurementBatch  @relation(fields: [procurementBatchId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@unique([procurementBatchId, purchaseOrderItemId])
  @@index([procurementBatchId])
  @@index([purchaseOrderItemId])
  @@map("batch_items")
}

// Mirrors AssetNumberSequence: per-year row for PO, per-yearMonth row
// for batch. Service-layer SELECT … FOR UPDATE bumps the counter inside
// the create transaction so concurrent imports never collide.
model PurchaseOrderSequence {
  id              String @id @default(uuid()) @db.Uuid
  year            Int    @unique @map("year")
  currentSequence Int    @default(0) @map("current_sequence")

  @@map("purchase_order_sequences")
}

model ProcurementBatchSequence {
  id              String @id @default(uuid()) @db.Uuid
  // YYYYMM packed as integer (e.g. 202605) so the @unique row lookup is
  // a single int comparison rather than string parsing.
  yearMonth       Int    @unique @map("year_month")
  currentSequence Int    @default(0) @map("current_sequence")

  @@map("procurement_batch_sequences")
}

// ─── Handover forms (Berita Acara Serah Terima) ─────────────────────────────────

// A printable, physically-signed handover document. Created BEFORE the
// corresponding AssetMovement rows exist: IT fills the form, downloads the
// PDF, collects wet signatures, scans it, and only then records the
// movements — attaching this form to each of them.
model HandoverForm {
  id           String             @id @default(uuid()) @db.Uuid
  // Indonesian letter format, e.g. "001/BAST-IT/WDS/VIII/2026". Contains
  // slashes, so it is NEVER a URL segment — routes address forms by `id`.
  formNumber   String             @unique @map("form_number")
  handoverType HandoverType       @map("handover_type")
  status       HandoverFormStatus @default(DRAFT) @map("status")
  // Date the physical handover takes place; may differ from createdAt when
  // the form is prepared ahead of time. Date-only — no meaningful time part.
  handoverDate DateTime           @map("handover_date") @db.Date

  // ── Parties ──
  // The IT officer running the handover. Always present: even for an
  // employee-to-employee transfer, IT witnesses and verifies.
  itOfficerUserId      String  @map("it_officer_user_id") @db.Uuid
  // Nullable per direction: COMPANY_TO_EMPLOYEE has no outgoing employee,
  // EMPLOYEE_TO_COMPANY has no incoming one. Enforced in the Zod schema.
  fromUserId           String? @map("from_user_id") @db.Uuid
  toUserId             String? @map("to_user_id") @db.Uuid
  // "Mengetahui" — supervisor countersigning. Optional: when absent the PDF
  // still prints the block so it can be signed by hand.
  acknowledgedByUserId String? @map("acknowledged_by_user_id") @db.Uuid
  fromLocationId       String? @map("from_location_id") @db.Uuid
  toLocationId         String? @map("to_location_id") @db.Uuid

  // Names/employee-ids/locations of every party, frozen at creation time.
  // A signed document must keep saying what was signed: renaming a user or
  // moving a location later must not retroactively alter the PDF.
  partySnapshot Json? @map("party_snapshot")

  purpose String? @map("purpose")
  notes   String? @map("notes")

  // ── Signed scan ──
  // Path relative to STORAGE_PATH, deliberately under `private/` so it is
  // NOT reachable through the unauthenticated /uploads static mount. Served
  // only via GET /api/handover-forms/:id/scan behind authenticate+authorize.
  scanFilePath         String?   @map("scan_file_path")
  scanFileName         String?   @map("scan_file_name")
  scanFileSize         Int?      @map("scan_file_size")
  scanUploadedAt       DateTime? @map("scan_uploaded_at")
  scanUploadedByUserId String?   @map("scan_uploaded_by_user_id") @db.Uuid

  // Stamped the first time the PDF is rendered, which also locks the form.
  pdfGeneratedAt DateTime? @map("pdf_generated_at")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  itOfficer      User               @relation("HandoverItOfficer", fields: [itOfficerUserId], references: [id], onDelete: Restrict)
  fromUser       User?              @relation("HandoverFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser         User?              @relation("HandoverToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  acknowledgedBy User?              @relation("HandoverAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  createdBy      User               @relation("HandoverCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  scanUploadedBy User?              @relation("HandoverScanUploadedBy", fields: [scanUploadedByUserId], references: [id], onDelete: SetNull)
  fromLocation   Location?          @relation("HandoverFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     Location?          @relation("HandoverToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  items          HandoverFormItem[]
  movements      AssetMovement[]

  @@index([status])
  @@index([handoverType])
  @@index([handoverDate])
  @@index([itOfficerUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("handover_forms")
}

// One asset line on a handover form. Denormalises the asset's identifying
// fields on purpose: the PDF must reflect the asset as it was at handover
// time, and `condition` in particular is the whole point of the signature
// (the receiver attests to the condition they accepted).
model HandoverFormItem {
  id             String @id @default(uuid()) @db.Uuid
  handoverFormId String @map("handover_form_id") @db.Uuid
  assetId        String @map("asset_id") @db.Uuid
  sortOrder      Int    @default(0) @map("sort_order")

  assetNumber  String  @map("asset_number")
  assetName    String  @map("asset_name")
  serialNumber String? @map("serial_number")
  condition    String  @map("condition")
  itemNotes    String? @map("item_notes")

  createdAt DateTime @default(now()) @map("created_at")

  form  HandoverForm @relation(fields: [handoverFormId], references: [id], onDelete: Cascade)
  asset Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // An asset can appear at most once per form — listing it twice would make
  // the signed quantities ambiguous.
  @@unique([handoverFormId, assetId])
  @@index([assetId])
  @@map("handover_form_items")
}

// Mirrors AssetNumberSequence/PurchaseOrderSequence. Keyed by document type
// so future letter kinds (BAPB, BAP, …) share the table without a migration.
// Bumped via INSERT … ON CONFLICT DO UPDATE RETURNING inside the creating
// transaction, so concurrent creates serialise on the row and a failed
// insert rolls the counter back.
model DocumentNumberSequence {
  id              String @id @default(uuid()) @db.Uuid
  documentType    String @map("document_type")
  year            Int    @map("year")
  currentSequence Int    @default(0) @map("current_sequence")

  @@unique([documentType, year])
  @@map("document_number_sequences")
}

// Single-row table holding company identity for document letterheads.
// Enforced as one row in service code (fixed well-known id) rather than by
// a constraint — a CHECK on a singleton adds friction without adding safety
// when nothing else writes the table.
model CompanySetting {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @map("name")
  address    String? @map("address")
  city       String? @map("city")
  province   String? @map("province")
  postalCode String? @map("postal_code")
  phone      String? @map("phone")
  email      String? @map("email")
  website    String? @map("website")
  logoUrl    String? @map("logo_url")

  // Segments of the generated document number: "…/BAST-{divisionCode}/{documentCode}/…"
  documentCode String @default("WDS") @map("document_code")
  divisionCode String @default("IT") @map("division_code")

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// SMS — Stock Management System (motorcycle units tracked per VIN)
//
// Design: docs/specs/sms-technical-design.md. Product spec:
// docs/specs/stock-management-system.md.
//
// Ground rules for everything below:
//   - One SmsUnit row per VIN across the whole network. It is a PROJECTION:
//     the append-only SmsUnitEvent ledger is the business truth, and the
//     unit row is rewritten from the reducer result inside the same
//     transaction that appends the event.
//   - A unit stores three independent facts: where it physically is
//     (physicalLocationId), which showroom answers for it
//     (responsibleShowroomId), and its lifecycle status.
//       physical stock of showroom L  =  physicalLocationId = L
//       ready to offer at showroom L  =  physicalLocationId = L AND status = AVAILABLE
//     physicalLocationId is non-null if and only if the motorcycle is inside
//     a showroom (never while it is with a customer or out at an event).
//   - "At most one" invariants (one booking/sale holding a VIN, one open RTO
//     contract, one unresolved return request, one show outing) are carried
//     by nullable UNIQUE pointer columns on SmsUnit, written only while the
//     unit row is locked. No raw-SQL partial index is needed for them.
//   - Nothing here references the AMS Asset/AssetMovement models. Shared FK
//     targets are User (employee; login optional) and Location.
// ═══════════════════════════════════════════════════════════════════════════

enum SmsUnitStatus {
  AVAILABLE // in a showroom, may be offered
  BOOKED // locked by an SPK line
  SOLD_PENDING_PICKUP // sold, still physically in the showroom
  PICKED_UP // with the customer for good (sold, or RTO ended in ownership transfer)
  ACTIVE_RTO // with the customer under a rent-to-own contract
  CUSTODY // left at another showroom, cross-branch return not officially received
  INSPECTION // received back / damaged — held until released
  SHOW_UNIT // out at an event, held by a PIC
  IDENTITY_MISMATCH // physically found but identity differs from the manifest
}

enum SmsUnitEventType {
  OPENING_BALANCE
  RECEIPT_OK
  RECEIPT_DAMAGED
  IDENTITY_MISMATCH_FOUND
  IDENTITY_RESOLVED
  INSPECTION_STARTED
  INSPECTION_PASSED
  INSPECTION_FAILED
  UNIT_RELEASED
  BOOKING_CREATED
  BOOKING_CANCELLED
  SALE_RECORDED
  PICKUP_CONFIRMED
  SALE_RETURN_RECEIVED
  SALE_RETURN_APPROVED
  SALE_RETURN_REJECTED
  RTO_STARTED
  RTO_RETURNED
  RTO_OWNERSHIP_TRANSFERRED
  RTO_CONTRACT_CLOSED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  CUSTODY_RECEIVED
  CUSTODY_HANDED_BACK
  OFFICIAL_RECEIPT_CONFIRMED
  SHOW_UNIT_DISPATCHED
  SHOW_UNIT_RETURNED
  EVENT_VOIDED
}

enum SmsShipmentLineStatus {
  PENDING // listed on the manifest, not physically confirmed yet
  RECEIVED_OK
  RECEIVED_DAMAGED
  DISCREPANCY // arrived with a different identity — see the linked unit
}

enum SmsOrderLineStatus {
  BOOKED
  SOLD
  PICKED_UP
  RTO_HANDED_OVER
  CANCELLED
  RETURNED
}

// Shared by cross-branch return requests and sale-return decisions.
enum SmsDecision {
  PENDING
  APPROVED
  REJECTED
}

enum SmsRtoReturnKind {
  RETURNED_BY_CUSTOMER
  REPOSSESSED
}

enum SmsRtoOutcome {
  RETURNED
  REPOSSESSED
  OWNERSHIP_TRANSFERRED
}

enum SmsInspectionReason {
  RECEIPT_DAMAGE
  IDENTITY_MISMATCH
  RTO_RETURN
  CROSS_BRANCH_RETURN
  SALE_RETURN
  SHOW_UNIT_RETURN
  OTHER
}

enum SmsInspectionResult {
  PENDING
  PASSED
  FAILED
}

enum SmsVehicleCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

// ── Product master ─────────────────────────────────────────────────────────

model SmsVehicleModel {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @map("code")
  name      String   @map("name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants SmsVehicleVariant[]

  @@index([isActive])
  @@map("sms_vehicle_models")
}

// One row = one sellable configuration: model + variant (the battery option
// is part of the variant) + colour. Sales search stock by exactly this
// combination, so it is a standardised choice rather than free text.
model SmsVehicleVariant {
  id             String   @id @default(uuid()) @db.Uuid
  modelId        String   @map("model_id") @db.Uuid
  name           String   @map("name")
  batteryVariant String?  @map("battery_variant")
  color          String   @map("color")
  colorHex       String?  @map("color_hex")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  model         SmsVehicleModel   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  units         SmsUnit[]
  shipmentLines SmsShipmentLine[]

  @@unique([modelId, name, color])
  @@index([modelId])
  @@index([isActive])
  @@map("sms_vehicle_variants")
}

// ── Inbound: factory manifest → expected VINs → physical receipt ───────────

// The part of a factory batch that is headed to ONE destination showroom.
// When the factory splits a batch across showrooms, each showroom gets its
// own SmsShipment sharing the same batchNumber, and sees only its own
// receiving progress. Progress is derived from line statuses, never stored.
model SmsShipment {
  id                    String    @id @default(uuid()) @db.Uuid
  batchNumber           String    @map("batch_number")
  // Surat jalan. Empty string when none was given — kept non-null so the
  // unique key below also de-duplicates shipments without a delivery note.
  deliveryNoteNumber    String    @default("") @map("delivery_note_number")
  destinationLocationId String    @map("destination_location_id") @db.Uuid
  originLocationId      String?   @map("origin_location_id") @db.Uuid
  dispatchDate          DateTime? @map("dispatch_date") @db.Date
  notes                 String?   @map("notes")
  sourceFileName        String?   @map("source_file_name")
  columnMapping         Json?     @map("column_mapping")
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  destinationLocation Location          @relation("SmsShipmentDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  originLocation      Location?         @relation("SmsShipmentOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  createdBy           User              @relation("SmsShipmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines               SmsShipmentLine[]
  units               SmsUnit[]

  @@unique([destinationLocationId, batchNumber, deliveryNoteNumber])
  @@index([batchNumber])
  @@index([createdAt])
  @@map("sms_shipments")
}

// One expected motorcycle. Importing a manifest only creates these lines
// ("expected to arrive"); the SmsUnit is created when an admin confirms the
// motorcycle physically arrived. A line with isExpected = false records a
// motorcycle that turned up without being on the manifest.
model SmsShipmentLine {
  id               String                @id @default(uuid()) @db.Uuid
  shipmentId       String                @map("shipment_id") @db.Uuid
  vin              String                @map("vin")
  engineNumber     String?               @map("engine_number")
  variantId        String?               @map("variant_id") @db.Uuid
  // Model/variant/colour text exactly as it appeared in the source file,
  // kept so an unmatched variant can still be shown and resolved later.
  rawModel         String?               @map("raw_model")
  rawVariant       String?               @map("raw_variant")
  rawColor         String?               @map("raw_color")
  // [{ row: number, values: Record<string,string> }] — every source row that
  // was folded into this candidate (component detail rows repeat the VIN).
  sourceRows       Json                  @map("source_rows")
  isExpected       Boolean               @default(true) @map("is_expected")
  receiptStatus    SmsShipmentLineStatus @default(PENDING) @map("receipt_status")
  discrepancyNotes String?               @map("discrepancy_notes")
  unitId           String?               @unique @map("unit_id") @db.Uuid
  receivedByUserId String?               @map("received_by_user_id") @db.Uuid
  receivedAt       DateTime?             @map("received_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  shipment   SmsShipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  variant    SmsVehicleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unit       SmsUnit?           @relation("SmsShipmentLineUnit", fields: [unitId], references: [id], onDelete: Restrict)
  receivedBy User?              @relation("SmsShipmentLineReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  events     SmsUnitEvent[]

  @@unique([shipmentId, vin])
  @@index([vin])
  @@index([shipmentId, receiptStatus])
  @@map("sms_shipment_lines")
}

// ── The unit (one per VIN) and its ledger ──────────────────────────────────

model SmsUnit {
  id                    String        @id @default(uuid()) @db.Uuid
  vin                   String        @unique @map("vin")
  engineNumber          String?       @map("engine_number")
  licensePlate          String?       @map("license_plate")
  variantId             String        @map("variant_id") @db.Uuid
  status                SmsUnitStatus @map("status")
  physicalLocationId    String?       @map("physical_location_id") @db.Uuid
  responsibleShowroomId String        @map("responsible_showroom_id") @db.Uuid
  // Set on the first RTO handover and never cleared — drives the "Ex-RTO" badge.
  wasRto                Boolean       @default(false) @map("was_rto")
  // True when the unit entered SMS through the cutover import, i.e. its
  // earlier history is not available.
  isOpeningBalance      Boolean       @default(false) @map("is_opening_balance")
  shipmentId            String?       @map("shipment_id") @db.Uuid
  // First time the unit was physically received into a showroom.
  receivedAt            DateTime?     @map("received_at")
  notes                 String?       @map("notes")

  // "At most one" pointers — see the header comment.
  activeOrderLineId   String? @unique @map("active_order_line_id") @db.Uuid
  openRtoContractId   String? @unique @map("open_rto_contract_id") @db.Uuid
  openReturnRequestId String? @unique @map("open_return_request_id") @db.Uuid
  openShowLoanId      String? @unique @map("open_show_loan_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  variant             SmsVehicleVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  physicalLocation    Location?         @relation("SmsUnitPhysicalLocation", fields: [physicalLocationId], references: [id], onDelete: Restrict)
  responsibleShowroom Location          @relation("SmsUnitResponsibleShowroom", fields: [responsibleShowroomId], references: [id], onDelete: Restrict)
  shipment            SmsShipment?      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  createdBy           User              @relation("SmsUnitCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  activeOrderLine   SmsOrderLine?     @relation("SmsUnitActiveOrderLine", fields: [activeOrderLineId], references: [id], onDelete: Restrict)
  openRtoContract   SmsRtoContract?   @relation("SmsUnitOpenRtoContract", fields: [openRtoContractId], references: [id], onDelete: Restrict)
  openReturnRequest SmsReturnRequest? @relation("SmsUnitOpenReturnRequest", fields: [openReturnRequestId], references: [id], onDelete: Restrict)
  openShowLoan      SmsShowLoan?      @relation("SmsUnitOpenShowLoan", fields: [openShowLoanId], references: [id], onDelete: Restrict)

  shipmentLine   SmsShipmentLine?   @relation("SmsShipmentLineUnit")
  events         SmsUnitEvent[]
  orderLines     SmsOrderLine[]     @relation("SmsOrderLineUnit")
  rtoContracts   SmsRtoContract[]   @relation("SmsRtoContractUnit")
  returnRequests SmsReturnRequest[] @relation("SmsReturnRequestUnit")
  showLoans      SmsShowLoan[]      @relation("SmsShowLoanUnit")
  inspections    SmsInspection[]

  @@index([physicalLocationId, status])
  @@index([responsibleShowroomId, status])
  @@index([variantId])
  @@index([status])
  @@index([engineNumber])
  @@index([licensePlate])
  @@map("sms_units")
}

// Append-only business history: "what happened to this motorcycle".
// Rows are never updated or deleted. A wrong entry is corrected by appending
// another event that points at it (supersedesEventId / voidsEventId); the
// EFFECTIVE ledger of a unit is the events that nothing supersedes or voids,
// ordered by seq.
model SmsUnitEvent {
  id                String           @id @default(uuid()) @db.Uuid
  // Insertion order. Events of one unit are appended under the unit row
  // lock, so seq is strictly increasing per unit.
  seq               Int              @unique @default(autoincrement()) @map("seq")
  unitId            String           @map("unit_id") @db.Uuid
  eventType         SmsUnitEventType @map("event_type")
  // Business date of the event (may be back-dated for late input) versus
  // recordedAt, the moment it was typed in.
  eventDate         DateTime         @map("event_date") @db.Date
  recordedAt        DateTime         @default(now()) @map("recorded_at")
  performedByUserId String?          @map("performed_by_user_id") @db.Uuid
  // The showroom where the event took place, when that matters to the
  // reducer (receipt, custody, return). Correctable via a superseding event.
  locationId        String?          @map("location_id") @db.Uuid
  // Extra reducer inputs for this event type (see unit-state.ts).
  payload           Json?            @map("payload")

  // Snapshot of the unit state the reducer produced when the event was
  // recorded. Informational — reports replay the effective ledger instead.
  statusAfter                SmsUnitStatus @map("status_after")
  physicalLocationAfterId    String?       @map("physical_location_after_id") @db.Uuid
  responsibleShowroomAfterId String        @map("responsible_showroom_after_id") @db.Uuid

  // Context links.
  shipmentLineId  String? @map("shipment_line_id") @db.Uuid
  orderLineId     String? @map("order_line_id") @db.Uuid
  rtoContractId   String? @map("rto_contract_id") @db.Uuid
  returnRequestId String? @map("return_request_id") @db.Uuid
  showLoanId      String? @map("show_loan_id") @db.Uuid
  inspectionId    String? @map("inspection_id") @db.Uuid

  // Corrections.
  supersedesEventId String? @unique @map("supersedes_event_id") @db.Uuid
  voidsEventId      String? @unique @map("voids_event_id") @db.Uuid

  reason      String? @map("reason")
  notes       String? @map("notes")
  attachments Json?   @map("attachments")

  unit          SmsUnit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  performedBy   User?             @relation("SmsUnitEventPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  location      Location?         @relation("SmsUnitEventLocation", fields: [locationId], references: [id], onDelete: Restrict)
  shipmentLine  SmsShipmentLine?  @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)
  orderLine     SmsOrderLine?     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  rtoContract   SmsRtoContract?   @relation(fields: [rtoContractId], references: [id], onDelete: Restrict)
  returnRequest SmsReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  showLoan      SmsShowLoan?      @relation(fields: [showLoanId], references: [id], onDelete: Restrict)
  inspection    SmsInspection?    @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  supersedes   SmsUnitEvent? @relation("SmsUnitEventSupersedes", fields: [supersedesEventId], references: [id], onDelete: Restrict)
  supersededBy SmsUnitEvent? @relation("SmsUnitEventSupersedes")
  voids        SmsUnitEvent? @relation("SmsUnitEventVoids", fields: [voidsEventId], references: [id], onDelete: Restrict)
  voidedBy     SmsUnitEvent? @relation("SmsUnitEventVoids")

  @@index([unitId, seq])
  @@index([eventDate])
  @@index([eventType])
  @@index([orderLineId])
  @@index([rtoContractId])
  @@index([returnRequestId])
  @@map("sms_unit_events")
}

// ── Outbound: SPK (order) and its per-VIN lines ────────────────────────────

// One SPK. Customer and sales are entered once and shared by every line.
// spkNumber is typed by the admin from the paper document.
model SmsOrder {
  id               String   @id @default(uuid()) @db.Uuid
  showroomId       String   @map("showroom_id") @db.Uuid
  spkNumber        String   @map("spk_number")
  salesUserId      String?  @map("sales_user_id") @db.Uuid
  customerName     String   @map("customer_name")
  customerPhone    String?  @map("customer_phone")
  customerIdNumber String?  @map("customer_id_number")
  notes            String?  @map("notes")
  isOpeningBalance Boolean  @default(false) @map("is_opening_balance")
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  showroom  Location       @relation("SmsOrderShowroom", fields: [showroomId], references: [id], onDelete: Restrict)
  sales     User?          @relation("SmsOrderSales", fields: [salesUserId], references: [id], onDelete: Restrict)
  createdBy User           @relation("SmsOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines     SmsOrderLine[]

  @@unique([showroomId, spkNumber])
  @@index([salesUserId])
  @@index([createdAt])
  @@map("sms_orders")
}

// One VIN on an SPK. Booking, sale, pickup, cancellation and sale return are
// all tracked per line, so "1 of 2 picked up" is a count over lines. Who did
// each step is recorded on the matching SmsUnitEvent.
model SmsOrderLine {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @map("order_id") @db.Uuid
  unitId     String             @map("unit_id") @db.Uuid
  status     SmsOrderLineStatus @default(BOOKED) @map("status")
  bookedAt   DateTime           @map("booked_at")
  followUpAt DateTime?          @map("follow_up_at")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  soldAt DateTime? @map("sold_at")

  pickedUpAt        DateTime? @map("picked_up_at")
  receiverName      String?   @map("receiver_name")
  handoverReference String?   @map("handover_reference")

  rtoHandoverAt DateTime? @map("rto_handover_at")

  // Sale return: physical receipt and the decision are separate steps.
  returnReceivedAt     DateTime?            @map("return_received_at")
  returnReason         String?              @map("return_reason")
  returnCondition      SmsVehicleCondition? @map("return_condition")
  returnDecision       SmsDecision?         @map("return_decision")
  returnDecidedAt      DateTime?            @map("return_decided_at")
  returnDecisionReason String?              @map("return_decision_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order         SmsOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  unit          SmsUnit          @relation("SmsOrderLineUnit", fields: [unitId], references: [id], onDelete: Restrict)
  activeForUnit SmsUnit?         @relation("SmsUnitActiveOrderLine")
  rtoContracts  SmsRtoContract[]
  events        SmsUnitEvent[]

  @@index([orderId])
  @@index([unitId])
  @@index([status])
  @@map("sms_order_lines")
}

// ── Rent to own ────────────────────────────────────────────────────────────

// One row per RTO period of a VIN. A second contract on the same VIN is a
// new row. The contract stays OPEN (closedAt null) after the motorcycle is
// physically returned, until an admin records the closure in SMS.
model SmsRtoContract {
  id               String  @id @default(uuid()) @db.Uuid
  // Typed by the admin from the contract document.
  contractNumber   String  @unique @map("contract_number")
  unitId           String  @map("unit_id") @db.Uuid
  // Showroom the contract originated from. Never changes, even when the
  // motorcycle is later returned to and re-offered by another showroom.
  originShowroomId String  @map("origin_showroom_id") @db.Uuid
  orderLineId      String? @map("order_line_id") @db.Uuid
  salesUserId      String? @map("sales_user_id") @db.Uuid
  customerName     String  @map("customer_name")
  customerPhone    String? @map("customer_phone")
  customerIdNumber String? @map("customer_id_number")

  startDate  DateTime  @map("start_date") @db.Date
  handoverAt DateTime? @map("handover_at")

  returnKind           SmsRtoReturnKind? @map("return_kind")
  returnedAt           DateTime?         @map("returned_at")
  receivedAtShowroomId String?           @map("received_at_showroom_id") @db.Uuid

  closedAt       DateTime?      @map("closed_at")
  closedByUserId String?        @map("closed_by_user_id") @db.Uuid
  legalReference String?        @map("legal_reference")
  outcome        SmsRtoOutcome? @map("outcome")
  notes          String?        @map("notes")

  isOpeningBalance Boolean  @default(false) @map("is_opening_balance")
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  unit               SmsUnit            @relation("SmsRtoContractUnit", fields: [unitId], references: [id], onDelete: Restrict)
  openForUnit        SmsUnit?           @relation("SmsUnitOpenRtoContract")
  originShowroom     Location           @relation("SmsRtoContractOriginShowroom", fields: [originShowroomId], references: [id], onDelete: Restrict)
  receivedAtShowroom Location?          @relation("SmsRtoContractReceivedAtShowroom", fields: [receivedAtShowroomId], references: [id], onDelete: Restrict)
  orderLine          SmsOrderLine?      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  sales              User?              @relation("SmsRtoContractSales", fields: [salesUserId], references: [id], onDelete: Restrict)
  closedBy           User?              @relation("SmsRtoContractClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  createdBy          User               @relation("SmsRtoContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  returnRequests     SmsReturnRequest[]
  inspections        SmsInspection[]
  events             SmsUnitEvent[]

  @@index([unitId, closedAt])
  @@index([originShowroomId])
  @@index([closedAt])
  @@map("sms_rto_contracts")
}

// ── Cross-branch return, with optional custody ("titipan") ─────────────────

// The decision and the physical facts are independent and may happen in
// either order, so they are stored as separate facts — never as one linear
// status. The display status is derived.
model SmsReturnRequest {
  id                String   @id @default(uuid()) @db.Uuid
  requestNumber     String   @unique @map("request_number")
  unitId            String   @map("unit_id") @db.Uuid
  rtoContractId     String?  @map("rto_contract_id") @db.Uuid
  // The unit's responsible showroom when the request was made (decides).
  fromShowroomId    String   @map("from_showroom_id") @db.Uuid
  // The showroom asking to receive the motorcycle.
  toShowroomId      String   @map("to_showroom_id") @db.Uuid
  reason            String   @map("reason")
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime @default(now()) @map("requested_at")

  decision        SmsDecision @default(PENDING) @map("decision")
  decidedByUserId String?     @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?   @map("decided_at")
  decisionReason  String?     @map("decision_reason")

  // Motorcycle left at toShowroom before the return was officially received.
  custodyReceivedAt  DateTime? @map("custody_received_at")
  // Official receipt by toShowroom (requires an approved decision).
  officialReceivedAt DateTime? @map("official_received_at")
  // How a rejected request that already held the motorcycle was settled.
  custodyResolvedAt  DateTime? @map("custody_resolved_at")
  custodyResolution  String?   @map("custody_resolution")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unit         SmsUnit         @relation("SmsReturnRequestUnit", fields: [unitId], references: [id], onDelete: Restrict)
  openForUnit  SmsUnit?        @relation("SmsUnitOpenReturnRequest")
  rtoContract  SmsRtoContract? @relation(fields: [rtoContractId], references: [id], onDelete: Restrict)
  fromShowroom Location        @relation("SmsReturnRequestFromShowroom", fields: [fromShowroomId], references: [id], onDelete: Restrict)
  toShowroom   Location        @relation("SmsReturnRequestToShowroom", fields: [toShowroomId], references: [id], onDelete: Restrict)
  requestedBy  User            @relation("SmsReturnRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy    User?           @relation("SmsReturnRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  inspections  SmsInspection[]
  events       SmsUnitEvent[]

  @@index([unitId])
  @@index([fromShowroomId, decision])
  @@index([toShowroomId, decision])
  @@map("sms_return_requests")
}

// ── Inspection and show-unit outings ───────────────────────────────────────

model SmsInspection {
  id              String               @id @default(uuid()) @db.Uuid
  unitId          String               @map("unit_id") @db.Uuid
  reason          SmsInspectionReason  @map("reason")
  result          SmsInspectionResult  @default(PENDING) @map("result")
  condition       SmsVehicleCondition? @map("condition")
  odometer        Int?                 @map("odometer")
  findings        String?              @map("findings")
  notes           String?              @map("notes")
  photos          Json?                @map("photos")
  inspectorUserId String?              @map("inspector_user_id") @db.Uuid
  inspectedAt     DateTime?            @map("inspected_at")
  rtoContractId   String?              @map("rto_contract_id") @db.Uuid
  returnRequestId String?              @map("return_request_id") @db.Uuid
  showLoanId      String?              @map("show_loan_id") @db.Uuid
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  unit          SmsUnit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inspector     User?             @relation("SmsInspectionInspector", fields: [inspectorUserId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("SmsInspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  rtoContract   SmsRtoContract?   @relation(fields: [rtoContractId], references: [id], onDelete: Restrict)
  returnRequest SmsReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  showLoan      SmsShowLoan?      @relation(fields: [showLoanId], references: [id], onDelete: Restrict)
  events        SmsUnitEvent[]

  @@index([unitId, createdAt])
  @@index([result])
  @@map("sms_inspections")
}

model SmsShowLoan {
  id                 String               @id @default(uuid()) @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  showroomId         String               @map("showroom_id") @db.Uuid
  eventName          String               @map("event_name")
  // Free text — event venues are not rows in `locations`.
  eventLocation      String               @map("event_location")
  picUserId          String?              @map("pic_user_id") @db.Uuid
  dispatchedAt       DateTime             @map("dispatched_at")
  expectedReturnDate DateTime             @map("expected_return_date") @db.Date
  returnedAt         DateTime?            @map("returned_at")
  returnCondition    SmsVehicleCondition? @map("return_condition")
  hasFindings        Boolean              @default(false) @map("has_findings")
  notes              String?              @map("notes")
  createdByUserId    String               @map("created_by_user_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  unit        SmsUnit         @relation("SmsShowLoanUnit", fields: [unitId], references: [id], onDelete: Restrict)
  openForUnit SmsUnit?        @relation("SmsUnitOpenShowLoan")
  showroom    Location        @relation("SmsShowLoanShowroom", fields: [showroomId], references: [id], onDelete: Restrict)
  pic         User?           @relation("SmsShowLoanPic", fields: [picUserId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("SmsShowLoanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  inspections SmsInspection[]
  events      SmsUnitEvent[]

  @@index([unitId])
  @@index([returnedAt, expectedReturnDate])
  @@map("sms_show_loans")
}

// ── Exactly-once recording ─────────────────────────────────────────────────

// The client sends an Idempotency-Key (a UUID minted when the form opens)
// with every mutating SMS request. The key row is written in the same
// transaction as the mutation, so a double click or a retry after a dropped
// connection replays the stored response instead of recording twice.
model SmsIdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @map("key")
  userId      String   @map("user_id") @db.Uuid
  operation   String   @map("operation")
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json     @map("response")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sms_idempotency_keys")
}
