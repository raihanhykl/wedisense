{
  "name": "wedisense",
  "version": "0.1.0",
  "private": true,
  "description": "Wedisense — Asset Management System for Wedison",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter shared build && pnpm --parallel --filter api --filter web build",
    "lint": "pnpm --parallel --filter api --filter web --filter shared lint",
    "typecheck": "pnpm --parallel --filter api --filter web --filter shared typecheck",
    "clean": "pnpm --parallel --filter api --filter web --filter shared clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
